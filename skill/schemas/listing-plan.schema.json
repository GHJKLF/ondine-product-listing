    "CopyGuardExemption": {
      "additionalProperties": false,
      "properties": {
        "normalized_span": {
          "minLength": 1,
          "title": "Normalized Span",
          "type": "string"
        },
        "source_field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Field Paths",
          "type": "array"
        },
        "target_field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Field Paths",
          "type": "array"
        },
        "whitelist_rule_id": {
          "enum": [
            "EXACT_CAPTURED_MATERIAL_NAME",
            "EXACT_CAPTURED_COMPOSITION_VALUE",
            "EXACT_CAPTURED_MEASUREMENT_VALUE"
          ],
          "title": "Whitelist Rule Id",
          "type": "string"
        }
      },
      "required": [
        "normalized_span",
        "whitelist_rule_id",
        "source_field_paths",
        "target_field_paths"
      ],
      "title": "CopyGuardExemption",
      "type": "object"
    },
    "CopyGuardResult": {
      "additionalProperties": false,
      "properties": {
        "algorithm_id": {
          "const": "ondine_copy_guard_v1",
          "title": "Algorithm Id",
          "type": "string"
        },
        "customer_field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Customer Field Paths",
          "type": "array"
        },
        "exemptions": {
          "items": {
            "$ref": "#/$defs/CopyGuardExemption"
          },
          "title": "Exemptions",
          "type": "array"
        },
        "forbidden_customer_hits": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Forbidden Customer Hits",
          "type": "array"
        },
        "non_whitelisted_shared_three_grams": {
          "items": {
            "$ref": "#/$defs/SharedThreeGram"
          },
          "title": "Non Whitelisted Shared Three Grams",
          "type": "array"
        },
        "normalization_version": {
          "const": "ondine_copy_guard_normalization_v1",
          "title": "Normalization Version",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Result",
          "type": "string"
        },
        "source_capture_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Capture Sha256",
          "type": "string"
        },
        "source_corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Corpus Sha256",
          "type": "string"
        },
        "source_field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Field Paths",
          "type": "array"
        },
        "source_media_alt_field_count": {
          "minimum": 0,
          "title": "Source Media Alt Field Count",
          "type": "integer"
        },
        "source_order_lcs": {
          "$ref": "#/$defs/SourceOrderLcs"
        },
        "target_corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Corpus Sha256",
          "type": "string"
        }
      },
      "required": [
        "algorithm_id",
        "normalization_version",
        "customer_field_paths",
        "source_field_paths",
        "source_media_alt_field_count",
        "source_capture_sha256",
        "source_corpus_sha256",
        "target_corpus_sha256",
        "report_sha256",
        "non_whitelisted_shared_three_grams",
        "exemptions",
        "forbidden_customer_hits",
        "source_order_lcs",
        "result"
      ],
      "title": "CopyGuardResult",
      "type": "object"
    },
    "DerivedFact": {
      "additionalProperties": false,
      "properties": {
        "currency": {
