{
  "$defs": {
    "AdditionalSelector": {
      "additionalProperties": false,
      "properties": {
        "fact_ref": {
          "pattern": "^fp\\.[a-z0-9_.-]+$",
          "title": "Fact Ref",
          "type": "string"
        },
        "option_name": {
          "minLength": 1,
          "title": "Option Name",
          "type": "string"
        },
        "pdp_order_id": {
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_selector$",
          "title": "Pdp Order Id",
          "type": "string"
        },
        "selector_order": {
          "maximum": 3,
          "minimum": 2,
          "title": "Selector Order",
          "type": "integer"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "pdp_order_id",
        "option_name",
        "values",
        "fact_ref",
        "selector_order"
      ],
      "title": "AdditionalSelector",
      "type": "object"
    },
    "ApprovedSizeMapping": {
