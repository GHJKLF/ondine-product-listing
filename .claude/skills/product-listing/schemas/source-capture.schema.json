        },
        "expected_absences": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Expected Absences",
          "type": "array"
        },
        "media": {
          "additionalProperties": true,
          "title": "Media",
          "type": "object"
        },
        "sections": {
          "items": {
