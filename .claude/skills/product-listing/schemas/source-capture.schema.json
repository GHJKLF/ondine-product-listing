        "url": {
          "title": "Url",
          "type": "string"
        },
        "url_sha256": {
          "title": "Url Sha256",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
