        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "conflict_id": {
          "minLength": 1,
          "title": "Conflict Id",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
